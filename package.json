{
	"name": "obsidian-checkbox-manager",
	"version": "1.0.0",
	"description": "Custom checkbox styles for Obsidian with switchable icon styles.",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"build:plugin": "node esbuild.config.mjs production",
		"deploy": "bun run build:plugin && bun run scripts/deploy.mjs",
		"typecheck": "tsc --noEmit -skipLibCheck",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"test": "vitest run"
	},
	"author": {
		"name": "Khoa Le",
		"url": "https://github.com/lhak1341"
	},
	"license": "MIT",
	"devDependencies": {
		"@typescript-eslint/parser": "^8.62.1",
		"builtin-modules": "5.3.0",
		"esbuild": "0.28.1",
		"eslint": "^10.6.0",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"jsdom": "^29.1.1",
		"obsidian": "latest",
		"typescript": "5.8.3",
		"vitest": "^4.1.10"
	}
}
